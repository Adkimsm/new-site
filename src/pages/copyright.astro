---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPage from "@/components/ContentPage.astro";
import { buildMetadata } from "@/lib/metadata";

const entry = await getEntry("pages", "copyright");
if (!entry) throw new Error("Page not found: copyright");
const { Content } = await render(entry);
const meta = buildMetadata({ title: entry.data.title, description: entry.data.description, path: "/copyright" });
---

<BaseLayout {...meta}>
  <ContentPage meta={entry.data}><Content /></ContentPage>
</BaseLayout>
