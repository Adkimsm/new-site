---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/posts";
import { siteConfig } from "@/lib/site-config";
import { buildMetadata } from "@/lib/metadata";

const posts = (await getPosts()).slice(0, 5);
const meta = buildMetadata({ path: "" });
---

<BaseLayout {...meta}>
  <section class="hero">
    <div class="hero-copy">
      <img src={siteConfig.avatar} alt="Adkinsm 的头像" width="112" height="112" />
      <h1>{siteConfig.name}</h1>
      <p>{siteConfig.description}</p>
      <nav class="hero-links" aria-label="快捷入口">
        <a href="/posts">文章</a>
        <a href="/about">关于</a>
        <a href="/links">链接</a>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={`mailto:${siteConfig.email}`}>邮箱</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
  </section>

  <section class="section" id="latest-posts">
    <div class="section-heading">
      <h2>最近文章</h2>
      <a class="more" href="/posts">全部文章 →</a>
    </div>
    <ul class="post-list">
      {posts.map((post) => (
        <li class={`post-item ${post.featured ? "post-item--featured" : ""}`}>
          <time class="post-date" datetime={post.date}>{post.date}</time>
          <a class="post-title" href={`/posts/${post.slug}`}>{post.title}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
